/include/ "cheshire.dtsi"

&spi {
  // Choose NOR in "boot-with", as it is only considered if `mmc` probe fails.
  // Thus, we boot from MMC (SD) if available and NOR flash otherwise.
  boot-with = <1>;
  mmc@0 {
    compatible = "mmc-spi-slot";
    reg = <0>; // CS
    spi-max-frequency = <25000000>;
    voltage-ranges = <3300 3300>;
    disable-wp;
  };
  nor@1 {
    compatible = "s25fl256s1", "jedec,spi-nor";
    reg = <1>; // CS
    spi-max-frequency = <25000000>;
    disable-wp;
  };
};

&soc {
  /*
   * usb@3008000 {
   * compatible = "generic-ohci";
   * reg = <0x0 0x3008000 0x0 0x1000>;
   * interrupt-parent = <&PLIC0>;
   * interrupts = <19>;
   * };
  */
  PLIC0: interrupt-controller@4000000 {
    riscv,ndev = <62>;
  };
  riscv_iommu: iommu@1011000 {
    compatible = "riscv,iommu";
    reg = <0x0 0x1011000 0x0 0x1000>;
    interrupts = <58 59 60>;
    interrupt-names = "cmdq", "fltq", "hpm";
    interrupt-parent = <&PLIC0>;
    #iommu-cells = <1>;
  };
  strela@1012000 {
    compatible = "cei,strela";
    reg = <0x0 0x1012000 0x0 0x1000>;
    iommus = <&riscv_iommu 0>;
  };
  eth: lowrisc-eth@1001000 {
    compatible = "lowrisc-eth";  
    device_type = "network";   
    interrupt-parent = <&PLIC0>;   
    interrupts = <62>; // one IRQ line from IOMMU on index 61 is unused
    // NOTE: MAC addreess must be uniqe if more than one GenesysII boards are on the same network
    // TO-DO: make it unique for different boards if more than one are used
    local-mac-address = [00 18 3e 02 e3 7f];
    reg = <0x0 0x1001000 0x0 0x10000>; 
  };
};