/include/ "cheshire.dtsi"

&spi {
  // Choose NOR in "boot-with", as it is only considered if `mmc` probe fails.
  // Thus, we boot from MMC (SD) if available and NOR flash otherwise.
  boot-with = <1>;
  mmc@0 {
    compatible = "mmc-spi-slot";
    reg = <0>; // CS
    spi-max-frequency = <25000000>;
    voltage-ranges = <3300 3300>;
    disable-wp;
  };
  nor@1 {
    compatible = "s25fl256s1", "jedec,spi-nor";
    reg = <1>; // CS
    spi-max-frequency = <25000000>;
    disable-wp;
  };
};

&soc {
  /*
   * usb@3008000 {
   * compatible = "generic-ohci";
   * reg = <0x0 0x3008000 0x0 0x1000>;
   * interrupt-parent = <&PLIC0>;
   * interrupts = <19>;
   * };
  */
  PLIC0: interrupt-controller@4000000 {
    riscv,ndev = <64>;
  };
  riscv_iommu: iommu@1001000 {
    compatible = "riscv,iommu";
    reg = <0x0 0x1001000 0x0 0x1000>;
    interrupts = <59 60 61>; // 62 unused, skipped
    interrupt-names = "cmdq", "fltq", "hpm";
    interrupt-parent = <&PLIC0>;
    #iommu-cells = <1>;
  };
  strela@1002000 {
    compatible = "cei,strela";
    interrupt-parent = <&PLIC0>;
    interrupt-names = "config_done", "exec_done";
    interrupts = <63 64>;
    reg = <0x0 0x1002000 0x0 0x1000>;
    iommus = <&riscv_iommu 0>;
  };
  eth: lowrisc-eth@1020000 {
      compatible = "lowrisc-eth";  
      device_type = "network";   
      interrupt-parent = <&PLIC0>;   
      interrupts = <58>;
      mac-address = [00 18 3e 02 e3 8f]; // This needs to change if more than one GenesysII on a VLAN
      reg = <0x0 0x1020000 0x0 0x10000>; 
  };
};